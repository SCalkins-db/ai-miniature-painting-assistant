# ==========================================================
# AI Miniature Painting Assistant
# .gitignore
# ==========================================================

# -----------------------------
# IDE
# -----------------------------
.idea/
.vscode/
*.code-workspace

# -----------------------------
# Python Virtual Environments
# -----------------------------
.venv/
venv/
env/
ENV/

# -----------------------------
# Python Cache / Compiled Files
# -----------------------------
__pycache__/
*.py[cod]
*$py.class

# -----------------------------
# Packaging
# -----------------------------
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# -----------------------------
# Testing / Coverage
# -----------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# -----------------------------
# Type Checkers / Linters
# -----------------------------
.mypy_cache/
.pyre/
.ruff_cache/
.pytype/

# -----------------------------
# Jupyter
# -----------------------------
.ipynb_checkpoints/

# -----------------------------
# Logs
# -----------------------------
*.log
logs/

# -----------------------------
# Runtime Databases
# -----------------------------
*.db
*.sqlite
*.sqlite3

# Keep schema/example databases if desired
!database/schema.db

# -----------------------------
# Runtime Generated Data
# -----------------------------
incoming/
archive/

data/workflows/imported/
data/workflows/resolver/

data/imports/import_log.csv
data/imports/image_processing_log.csv
data/imports/video_processing_log.csv

review/review_queue.csv

# -----------------------------
# Generated Reports / Exports
# -----------------------------
exports/
reports/

# -----------------------------
# Temporary Files
# -----------------------------
*.tmp
*.temp
*.bak
*.old

# -----------------------------
# Microsoft Office Temporary Files
# -----------------------------
~$*.xlsx
~$*.xls
~$*.docx
~$*.doc

# -----------------------------
# Generated Project Tree Dumps
# -----------------------------
project_tree*.txt

# -----------------------------
# OS Files
# -----------------------------
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------
# Git Merge / Patch Files
# -----------------------------
*.orig
*.rej

# -----------------------------
# Environment Variables
# -----------------------------
.env
.env.*
!.env.example

# -----------------------------
# Docker
# -----------------------------
docker-compose.override.yml

# -----------------------------
# Project-Specific Generated Files
# -----------------------------
*.pid
*.seed

# -----------------------------
# Keep Important Documentation
# -----------------------------
!README.md
!LICENSE